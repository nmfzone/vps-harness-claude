{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["oh-my-openagent@{{ omo_plugin_version }}"],
  "model": {{ ('omniroute/' ~ omniroute_model_daily) | to_json }},
  "small_model": {{ ('omniroute/' ~ omniroute_model_quick) | to_json }},
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": {
        "baseURL": {{ omniroute_api_base_url | to_json }},
        "apiKey": {{ vault_omniroute_token | to_json }},
      },
      "models": {
{% for model in omniroute_models %}
        {{ model.id | to_json }}: {
          "name": {{ model.name | to_json }},
          "modalities": {
            "input": {{ model.input | to_json }},
            "output": {{ model.output | to_json }}
          },
          "limit": {
            "context": {{ model.context_window | to_json }},
            "output": {{ model.max_tokens | to_json }}
          },
          "attachment": {{ model.attachment | to_json }},
          "tool_call": {{ model.tool_call | to_json }},
          "temperature": {{ model.temperature | to_json }}
        }{{ ',' if not loop.last else '' }}
{% endfor %}
      }
    }
  }
}