{
  "daemon": {
    "listen": "0.0.0.0:{{ paseo_port }}",
    "hostnames": ["localhost", ".localhost", "{{ tailscale_hostname }}"]
  },
  "agents": {
    "providers": {
      "claude": {
        "models": [
{% for model in omniroute_models %}
          {
            "id": {{ ('omniroute/' ~ model.id) | to_json }},
            "label": {{ model.name | to_json }}{{ ',' if model.id == omniroute_model_daily else '' }}
{% if model.is_default %}
            "isDefault": true
{% endif %}
          }{{ ',' if not loop.last else '' }}
{% endfor %}
        ]
      },
      "opencode": {
        "models": [
{% for model in omniroute_models %}
          {
            "id": {{ ('omniroute/' ~ model.id) | to_json }},
            "label": {{ model.name | to_json }}{{ ',' if model.id == omniroute_model_daily else '' }}
{% if model.is_default %}
            "isDefault": true
{% endif %}
          }{{ ',' if not loop.last else '' }}
{% endfor %}
        ]
      },
      "omp": {
        "models": [
{% for model in omniroute_models %}
          {
            "id": {{ ('omniroute/' ~ model.id) | to_json }},
            "label": {{ model.name | to_json }}{{ ',' if model.id == omniroute_model_daily else '' }}
{% if model.is_default %}
            "isDefault": true
{% endif %}
          }{{ ',' if not loop.last else '' }}
{% endfor %}
        ]
      }
    }
  },
  "features": {
    "webUi": {
      "enabled": true
    }
  }
}
